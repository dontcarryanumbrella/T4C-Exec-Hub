# Postgres connection string (a free hosted database such as Prisma Postgres
# or Neon works for local development too).
DATABASE_URL="postgres://user:password@host:5432/dbname"

# Public URL used in sign-in links.
APP_URL="http://localhost:3000"

# Optional: send real emails from the club's Gmail account, using an app
# password (Google Account > Security > 2-Step Verification > App passwords).
# When unset, sign-in links are printed to the server console instead (fine
# for local development).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
EMAIL_FROM_NAME="T4C Hub"

# Secret for the daily reminder job (/api/reminders). Vercel Cron sends it
# automatically when CRON_SECRET is set in the project's environment.
CRON_SECRET=""
